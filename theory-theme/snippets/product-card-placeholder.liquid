{%- comment -%}
  Renders a placeholder product card

  Usage:
  {% render 'product-card-placeholder' %}
{%- endcomment -%}

<div class="product-card product-card--placeholder">
  <div class="product-card__link">
    <div class="product-card__media product-card__media--portrait">
      <div class="product-card__placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}
      </div>
    </div>
  </div>

  <div class="product-card__info">
    <h3 class="product-card__title">
      <span>Example Product Title</span>
    </h3>

    <div class="product-card__price">
      <span class="product-card__price-regular">$99.00</span>
    </div>
  </div>
</div>
