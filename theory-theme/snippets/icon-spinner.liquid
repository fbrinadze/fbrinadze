{%- comment -%}
  Renders a loading spinner icon

  Usage:
  {% render 'icon-spinner' %}
{%- endcomment -%}

<svg class="icon icon-spinner" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
  <circle class="icon-spinner__track" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" opacity="0.25"/>
  <path class="icon-spinner__head" d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
  </path>
</svg>
