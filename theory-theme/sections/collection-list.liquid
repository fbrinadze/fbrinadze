<section class="collection-list" data-section-id="{{ section.id }}" data-section-type="collection-list">
  <div class="collection-list__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-list__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="collection-list__grid collection-list__grid--{{ section.settings.columns_desktop }}">
      {%- for block in section.blocks -%}
        <div class="collection-list__item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.collection.url | default: '#' }}" class="collection-list__link">
            <div class="collection-list__image-wrapper">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag:
                  loading: 'lazy',
                  class: 'collection-list__image',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  widths: '375, 550, 750, 800'
                }}
              {%- elsif block.settings.collection.featured_image != blank -%}
                {{ block.settings.collection.featured_image | image_url: width: 800 | image_tag:
                  loading: 'lazy',
                  class: 'collection-list__image',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  widths: '375, 550, 750, 800'
                }}
              {%- else -%}
                <div class="collection-list__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'collection-list__placeholder-svg' }}
                </div>
              {%- endif -%}
              <div class="collection-list__overlay"></div>
            </div>
            <div class="collection-list__content">
              <h3 class="collection-list__title">
                {{ block.settings.title | default: block.settings.collection.title | default: 'Collection' }}
              </h3>
              {%- if section.settings.show_product_count and block.settings.collection != blank -%}
                <p class="collection-list__count">{{ block.settings.collection.products_count }} {{ 'collections.products' | t | default: 'products' }}</p>
              {%- endif -%}
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "class": "section-collection-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Optional. Uses collection image if not set."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Optional. Uses collection title if not set."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
