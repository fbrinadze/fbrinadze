<section class="main-collection" data-section-id="{{ section.id }}" data-section-type="main-collection">
  <div class="main-collection__container">
    <div class="main-collection__header">
      <div class="main-collection__header-left">
        {%- if section.settings.enable_filtering -%}
          <button class="main-collection__filter-toggle" data-filter-toggle aria-expanded="false">
            <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 1H18" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3 6H15" stroke="currentColor" stroke-width="1.5"/>
              <path d="M6 11H12" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            Filter
          </button>
        {%- endif -%}

        <p class="main-collection__count">
          {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
        </p>
      </div>

      {%- if section.settings.enable_sorting -%}
        <div class="main-collection__sort">
          <label for="sort-by" class="visually-hidden">Sort by</label>
          <select id="sort-by" class="main-collection__sort-select" data-sort-select>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if collection.sort_by == option.value %} selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>

    <div class="main-collection__content">
      {%- if section.settings.enable_filtering -%}
        <aside class="main-collection__sidebar{% if section.settings.filter_type == 'drawer' %} main-collection__sidebar--drawer{% endif %}" data-filter-sidebar>
          <div class="main-collection__sidebar-header">
            <h3 class="main-collection__sidebar-title">Filters</h3>
            <button class="main-collection__sidebar-close" data-filter-close aria-label="Close filters">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 4L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M4 4L12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
          </div>

          {%- form 'collection-filters', collection, class: 'main-collection__filters' -%}
            {%- for filter in collection.filters -%}
              <details class="main-collection__filter" open>
                <summary class="main-collection__filter-summary">
                  {{ filter.label }}
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="main-collection__filter-content">
                  {%- case filter.type -%}
                    {%- when 'list' -%}
                      <ul class="main-collection__filter-list">
                        {%- for value in filter.values -%}
                          <li class="main-collection__filter-item">
                            <label class="main-collection__filter-label">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                class="main-collection__filter-checkbox"
                              >
                              <span class="main-collection__filter-text">{{ value.label }}</span>
                              <span class="main-collection__filter-count">({{ value.count }})</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- when 'price_range' -%}
                      <div class="main-collection__filter-price">
                        <div class="main-collection__filter-price-field">
                          <span class="main-collection__filter-price-currency">{{ cart.currency.symbol }}</span>
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            id="filter-{{ filter.label | handleize }}-min"
                            class="main-collection__filter-price-input"
                            placeholder="0"
                            min="0"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                          >
                          <label for="filter-{{ filter.label | handleize }}-min" class="visually-hidden">Minimum price</label>
                        </div>
                        <span class="main-collection__filter-price-separator">to</span>
                        <div class="main-collection__filter-price-field">
                          <span class="main-collection__filter-price-currency">{{ cart.currency.symbol }}</span>
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            id="filter-{{ filter.label | handleize }}-max"
                            class="main-collection__filter-price-input"
                            placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            min="0"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                          >
                          <label for="filter-{{ filter.label | handleize }}-max" class="visually-hidden">Maximum price</label>
                        </div>
                      </div>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}

            <div class="main-collection__filter-actions">
              <button type="submit" class="button button--primary main-collection__filter-apply">Apply</button>
              <a href="{{ collection.url }}" class="button button--secondary main-collection__filter-clear">Clear all</a>
            </div>
          {%- endform -%}
        </aside>
        <div class="main-collection__sidebar-overlay" data-filter-overlay></div>
      {%- endif -%}

      <div class="main-collection__products">
        {%- paginate collection.products by section.settings.products_per_page -%}
          <div class="main-collection__grid main-collection__grid--{{ section.settings.columns_desktop }}">
            {%- for product in collection.products -%}
              {% render 'product-card',
                product: product,
                show_vendor: section.settings.show_vendor,
                show_secondary_image: section.settings.show_secondary_image,
                image_ratio: section.settings.image_ratio
              %}
            {%- else -%}
              <p class="main-collection__empty">No products found in this collection.</p>
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="main-collection__pagination" role="navigation" aria-label="Pagination">
              <ul class="main-collection__pagination-list">
                {%- if paginate.previous -%}
                  <li class="main-collection__pagination-item">
                    <a href="{{ paginate.previous.url }}" class="main-collection__pagination-link main-collection__pagination-link--prev" aria-label="Previous page">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 9.5L4 6L7.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  </li>
                {%- endif -%}

                {%- for part in paginate.parts -%}
                  <li class="main-collection__pagination-item">
                    {%- if part.is_link -%}
                      <a href="{{ part.url }}" class="main-collection__pagination-link">{{ part.title }}</a>
                    {%- else -%}
                      <span class="main-collection__pagination-link main-collection__pagination-link--current" aria-current="page">{{ part.title }}</span>
                    {%- endif -%}
                  </li>
                {%- endfor -%}

                {%- if paginate.next -%}
                  <li class="main-collection__pagination-item">
                    <a href="{{ paginate.next.url }}" class="main-collection__pagination-link main-collection__pagination-link--next" aria-label="Next page">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_type",
      "label": "Filter type",
      "options": [
        {
          "value": "sidebar",
          "label": "Sidebar"
        },
        {
          "value": "drawer",
          "label": "Drawer"
        }
      ],
      "default": "drawer"
    }
  ]
}
{% endschema %}
